# Test environment for the backend suite.
#
# Copy to backend/.env.test and fill in the two values marked FROM DASHBOARD.
# backend/.env.test is gitignored and must never be committed.
#
# tests/conftest.py loads this file into the process environment BEFORE any
# app import, and real environment variables take precedence over it, so CI can
# override any line here without editing the file.
#
# Setup, once:
#   1. Supabase dashboard -> project "bluntly-ph-test" -> Settings -> Database
#      -> Reset database password. Copy it into the two connection strings below.
#   2. Settings -> API -> copy the service_role / secret key into SUPABASE_SECRET_KEY.
#   3. cd backend && .venv/Scripts/python -m alembic upgrade head
#   4. cd backend && .venv/Scripts/python -m pytest
#
# See docs/ENVIRONMENTS.md.

# --- Declares this a test target. Without it the guard refuses to run. -------
# Necessary but NOT sufficient: app/core/env_guard.py also checks that the
# connection does not point at the production project, so this marker cannot
# be used to unlock production.
BLUNTLY_TEST_ENV=1
APP_ENV=test

# --- The dedicated test Supabase project (free tier, ap-southeast-1) --------
# Project ref: miysywhcdqkoniaibglx  — separate from production entirely.
USE_SUPABASE=true
SUPABASE_URL=https://miysywhcdqkoniaibglx.supabase.co

# FROM DASHBOARD: Settings -> API -> service_role (secret) key.
# Only needed by tests that exercise Supabase Storage for real; the rest
# monkeypatch the client.
SUPABASE_SECRET_KEY=

# FROM DASHBOARD: Settings -> Database -> connection string.
# Session pooler (port 5432) is what Alembic uses; the app derives the
# transaction pooler (6543) from it. Substitute the password you set.
SUPABASE_CONNECTION_STRING_SESSION_POOLER=

# These MUST be present even when blank. The guard and pydantic both merge the
# repo-root .env underneath this file, so a key left out here keeps its
# PRODUCTION value and the guard will (correctly) refuse to run. Blanking them
# explicitly is what makes this file a complete override rather than a patch.
SUPABASE_CONNECTION_STRING=
SUPABASE_CONNECTION_STRING_TRANSACTION_POOLER=
SUPABASE_JWKS_URL=
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=

# --- Everything below keeps the suite offline and cheap ---------------------
# No outbound email, no spend, no OTP codes in transit.
EMAIL_PROVIDER=console
RESEND_API_KEY=

# A throwaway signing key: tokens minted here must never be valid anywhere else.
JWT_SECRET=test-only-secret-not-used-anywhere-else-0123456789abcdef

# Rate limiting fails open when Redis is absent, which is fine for tests.
REDIS_URL=

# Never let a test reach a real payout provider.
PAYOUT_PROVIDER=manual
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
