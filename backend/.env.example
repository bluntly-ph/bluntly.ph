# ─────────────────────────────────────────────────────────────────────────────
# Bluntly.ph backend — environment variables
# Copy to the repo-root .env (the frontend shares it) and fill in real values.
# NEVER commit real secrets. SUPABASE_SECRET_KEY must never reach the client.
# ─────────────────────────────────────────────────────────────────────────────

# --- App ---
APP_ENV=local                 # local | staging | production
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
ENABLE_DOCS=true              # set false to hide /docs, /redoc, /openapi.json

# --- Database (SQLAlchemy / Alembic) ---
# Local docker-compose Postgres by default.
DATABASE_URL=postgresql+psycopg://bluntly:bluntly@localhost:5432/bluntly

# Target Supabase instead of DATABASE_URL for runtime + migrations.
# Set USE_SUPABASE=true and paste the Supabase Postgres connection string below.
# IMPORTANT: the DIRECT host (db.<ref>.supabase.co) is IPv6-only — from an IPv4
# network use the SESSION-mode POOLER string (host aws-<n>-<region>.pooler.supabase.com,
# user postgres.<ref>, port 5432). The scheme is normalized to postgresql+psycopg and
# sslmode=require is applied automatically; special chars in the password are
# re-encoded, so paste it as Supabase gives it.
USE_SUPABASE=false
# Direct string (IPv6-only). Optional if the pooler string below is set.
SUPABASE_CONNECTION_STRING=
# SESSION pooler (IPv4, aws-<n>-<region>.pooler.supabase.com:5432, user
# postgres.<ref>). Used by ALEMBIC. Migrations need session mode: our
# `ALTER TYPE ... ADD VALUE` runs in an autocommit block.
# ⚠ Measured on a live project: session mode accepts only ~4 concurrent clients
# (FATAL: EMAXCONNSESSION), so the APP must NOT serve from it — it 500s under
# load. production_issues() refuses a production boot that does.
SUPABASE_CONNECTION_STRING_SESSION_POOLER=
# TRANSACTION pooler (:6543) — what the APP serves from; it multiplexes many
# clients onto few server connections (30+ verified). Leave blank to derive it
# from the session string (same host, port 5432 -> 6543).
SUPABASE_CONNECTION_STRING_TRANSACTION_POOLER=
DB_SSLMODE=require

# --- Performance (engine pool + threadpool) ---
# Total DB connections ~= workers x (DB_POOL_SIZE + DB_MAX_OVERFLOW) + Celery
# worker/beat. Defaults: 2 workers -> 2x(10+10) + ~4 ~= 44. That is only viable
# because the app talks to the TRANSACTION pooler, which multiplexes; the session
# pooler would reject it at 4 clients.
DB_POOL_SIZE=10               # persistent pooled connections per process
DB_MAX_OVERFLOW=10            # extra burst connections above pool_size
DB_POOL_TIMEOUT=10            # seconds to wait for a connection (fail fast, not 30s)
DB_POOL_RECYCLE=300           # recycle connections after N seconds (pooler-safe)
# In-flight sync requests per process. MUST stay <= DB_POOL_SIZE + DB_MAX_OVERFLOW
# (enforced at startup): every sync endpoint holds its connection for the whole
# request, so admitting more just 500s the surplus on pool timeout.
THREADPOOL_TOKENS=20

# --- Redis (Celery broker + rate-limit + cache) ---
REDIS_URL=redis://localhost:6379/0

# --- Supabase ---
# Publishable/anon key: safe for the client under RLS. Exposed to the frontend
# as NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY there; read server-side here too.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret/service-role key: SERVER-ONLY. Bypasses RLS for admin CSV import,
# Honesty Fund jobs, PII retention jobs. Never NEXT_PUBLIC_, never sent to client.
SUPABASE_SECRET_KEY=sb_secret_xxx
# JWKS endpoint used to validate Supabase-issued JWTs (asymmetric RS256/ES256).
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# --- Security / rate limiting ---
# Fixed-window auth rate limit (requests per window per client key).
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- Auth (FastAPI-native JWT/OAuth2 — ADR-010) ---
# HS256 signing secret for app-issued access tokens. MUST be a strong random value
# in staging/production. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI critique (ADR-013) ---
# provider: stub (default, no key) | claude | openai
AI_PROVIDER=stub
AI_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Community voting (M2 slice 2) ---
# Max votes per client per 60s window (reuses the fixed-window limiter).
VOTE_RATE_LIMIT_MAX=30

# --- Trust visibility thresholds (M2 slice 4) ---
# A product with >= PRODUCT_TRUST_MIN_REVIEWS published reviews AND
# trust_score < PRODUCT_TRUST_VISIBILITY_THRESHOLD is excluded from the default
# product listing (still fetchable by id with low_trust=true). 0.0 disables.
PRODUCT_TRUST_VISIBILITY_THRESHOLD=0.0
PRODUCT_TRUST_MIN_REVIEWS=5
# Sellers below this get low_trust=true on their profile (never hidden). 0.0 disables.
SELLER_TRUST_VISIBILITY_THRESHOLD=0.0

# --- Fraud signals (M2 slice 5; advisory to moderators, never auto-block) ---
# pg_trgm similarity above which a review discussion is flagged as duplicate.
DUPLICATE_SIMILARITY_THRESHOLD=0.85

# --- Token economy (M2 slice 7) ---
TOKENS_ON_REVIEW_PUBLISHED=10
TOKENS_ON_COMMISSION=25

# --- PII retention (M2 slice 8) ---
# Salt for the 30-day IP hashing step. REQUIRED to be a strong random value in
# production (checked by production_issues()).
PII_HASH_SALT=dev-pii-salt

# --- Request board (M3 slice 9) ---
REQUEST_MIN_BOUNTY=10             # minimum tokens escrowed to post a request
REQUEST_TOPUP_PER_UPVOTE=2        # platform-minted bonus per up-vote
REQUEST_TOPUP_CAP=50              # ceiling on that bonus
REQUEST_TTL_DAYS=30               # open -> expired (escrow refunded)

# --- Review contracts (M3 slice 10) ---
CONTRACT_TERM_MONTHS=6            # auto-renews unless the reviewer opts out

# --- Payouts (M3 slice 11) ---
PAYOUT_MIN_PHP=300.00             # minimum wallet balance to be scheduled
# paypal_sandbox (default) | paypal_live | manual.
# `manual` needs no credentials: a moderator marks payouts paid by hand.
PAYOUT_PROVIDER=paypal_sandbox
# Payouts API credentials. Missing creds are NOT fatal — the batch stays
# `scheduled` and is payable via the manual rail.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# https://api-m.sandbox.paypal.com (sandbox) | https://api-m.paypal.com (live).
# PAYOUT_PROVIDER=paypal_live with a sandbox URL is refused at startup.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# --- Lazada affiliate (M3 slice 12) — see docs/LAZADA_INTEGRATION.md ---
# Postback receiver. Lazada signs nothing, so this shared secret in the URL is
# the ONLY thing standing between /api/v1/postback/lazada and forged conversion
# rows. Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
# Empty = receiver disabled (503). Under 32 chars = refused in production.
# This is also why a postback never creates a commission; see the doc.
LAZADA_POSTBACK_SECRET=
# Open API — the SIGNED source, safe to reconcile money from.
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_USER_TOKEN=
LAZADA_API_BASE=https://api.lazada.com.ph/rest
LAZADA_SYNC_LOOKBACK_DAYS=7

# --- Frontend origins for CORS (comma-separated) ---
# Add the deployed frontend origin here, e.g.
#   CORS_ORIGINS=http://localhost:3000,https://bluntly.ph
# Must never contain '*' in production (startup guard).
CORS_ORIGINS=http://localhost:3000
