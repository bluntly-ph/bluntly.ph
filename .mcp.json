{
  "mcpServers": {
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=byobedbhodhvocgrkrse"
    },
    "claude_design": {
      "type": "http",
      "url": "https://api.anthropic.com/v1/design/mcp"
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated",
        "--browser",
        "chrome",
        "--viewport-size",
        "1280,900",
        "--output-dir",
        ".playwright-mcp"
      ]
    },
    "google-sheets": {
      "type": "stdio",
      "command": "${UVX_PATH:-uvx}",
      "args": [
        "--from",
        "mcp-google-sheets@latest",
        "--with",
        "mcp<2",
        "mcp-google-sheets"
      ],
      "env": {
        "SERVICE_ACCOUNT_PATH": "${GOOGLE_SHEETS_SA_KEY}",
        "ENABLED_TOOLS": "list_sheets,get_sheet_data,update_cells,batch_update_cells,add_rows"
      }
    }
  }
}