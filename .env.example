# Repo-root environment — shared by the Next.js frontend and the FastAPI backend.
#
# Copy to `.env` and fill in. `.env` is gitignored; only this template is tracked.
# Settings reads `../.env`, then `backend/.env`, then `backend/.env.test`, with
# later files winning and real environment variables winning over all of them.
#
# PLACEHOLDERS ONLY. Never commit a real key here.
#
# ---------------------------------------------------------------------------
# THIS FILE CONFIGURES PRODUCTION when filled with production values.
# For local development create `backend/.env.test` instead — the dev launcher
# refuses to start against production. See docs/ENVIRONMENTS.md.
# ---------------------------------------------------------------------------

# --- Environment selector --------------------------------------------------
# local | staging | production. Note: the guard does NOT trust this alone; it
# also inspects what the connection strings actually point at.
# local | staging | production
#
# This one flag decides whether the production self-check runs at all.
# `Settings.production_issues()` refuses to start the app on a wildcard CORS
# origin, a localhost Redis, a placeholder PII salt, a missing PayPal
# credential or a weak postback secret - and `main.py` only consults it when
# APP_ENV is exactly "production". Deployed without it, every one of those
# checks is inert in the only environment written for.
#
# Set it in production ONLY once the values below are real, or the app will
# correctly refuse to boot.
APP_ENV=local

# Backs rate limiting on login, register, OTP, voting, reporting and comments.
# Leave blank and the limiter falls back to Postgres (migration 0028), which is
# slower but present; with neither reachable it fails open and logs a warning.
# On 2026-08-20 this was unset in production and login was unthrottled -
# fourteen consecutive failures from one address, no 429.
REDIS_URL=redis://localhost:6379/0

# --- Supabase --------------------------------------------------------------
USE_SUPABASE=true
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Session pooler (port 5432) — Alembic uses this. The app derives the
# transaction pooler (6543) from it. See docs/PRODUCTION.md.
SUPABASE_CONNECTION_STRING_SESSION_POOLER=postgresql://postgres.your-project:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
SUPABASE_CONNECTION_STRING=postgresql://postgres:PASSWORD@db.your-project.supabase.co:5432/postgres

# --- Auth ------------------------------------------------------------------
# 32+ random characters. Tokens signed with this are valid across the whole app.
JWT_SECRET=change-me-to-a-long-random-value-at-least-32-chars
SESSION_COOKIE_NAME=bluntly_session

# --- Frontend --------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Email (OTP delivery) --------------------------------------------------
# `console` prints the code instead of sending. Use it for anything local:
# `resend` with a real key sends real mail to real people.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=noreply@mail.your-domain
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5

# --- Payouts ---------------------------------------------------------------
# manual | paypal_sandbox | paypal_live. `paypal_live` is refused unless
# credentials are set and PAYPAL_BASE_URL is not a sandbox URL.
PAYOUT_PROVIDER=manual
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# --- Privacy ---------------------------------------------------------------
# Salt for hashing session IPs (RA 10173 retention schedule). Rotating it
# breaks the link between old and new hashes, which is usually the point.
PII_HASH_SALT=change-me-to-a-long-random-value

# --- Lazada postbacks (optional) -------------------------------------------
LAZADA_POSTBACK_SECRET=
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_USER_TOKEN=
LAZADA_API_BASE=https://api.lazada.co.id/rest
LAZADA_SYNC_LOOKBACK_DAYS=7
